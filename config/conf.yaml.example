app:
  # HTTP listener: use loopback behind an HTTPS reverse proxy.
  # Public HTTP requires explicit RP_ALLOW_INSECURE_PUBLIC_BIND=1.
  # Set RP_COOKIE_SECURE=1 when the browser connects through HTTPS.
  host: 127.0.0.1
  port: 8080
  security_dir: dfhg156d1
  #session_ttl hours
  session_ttl: 24
  secret_key: 27257ae8c2ef465bbf13
  #workers 0:auto
  workers: 0
  #language zh-CN,en-US
  locale: zh-CN
  #file open edit max size MB
  max_file_size: 5
database:
  path: ./data.db3
  max_pool: 10